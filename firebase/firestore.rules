rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per member, readable and writable only by that member.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stamps', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.stamps == 0;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stamps', 'updatedAt'])
        && request.resource.data.stamps is int
        && request.resource.data.stamps >= 0 && request.resource.data.stamps <= 10;

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
