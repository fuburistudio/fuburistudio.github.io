rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per member, readable and writable only by that member.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stamps', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.stamps == 0;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stamps', 'updatedAt', 'booking'])
        && request.resource.data.stamps is int
        && request.resource.data.stamps >= 0 && request.resource.data.stamps <= 10
        && (!request.resource.data.keys().hasAny(['booking'])
            || request.resource.data.booking == null
            || (request.resource.data.booking is map
                && request.resource.data.booking.keys().hasOnly(['menu', 'minutes', 'date', 'time'])
                && request.resource.data.booking.menu is string && request.resource.data.booking.menu.size() <= 40
                && request.resource.data.booking.minutes is int
                && request.resource.data.booking.date is string && request.resource.data.booking.date.size() == 10
                && request.resource.data.booking.time is string && request.resource.data.booking.time.size() <= 5));

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
